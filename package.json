{
  "name": "todoes-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:playground": "npm --workspace apps/playground run dev",
    "build:playground": "npm --workspace apps/playground run build",
    "dev:mvvm": "npm --workspace apps/mvvm run dev",
    "dev:mvc": "npm --workspace apps/mvc run dev",
    "dev:mvp": "npm --workspace apps/mvp run dev"
  }
}